# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Project Settings > API > service_role (keep secret!)

# --- Admin webapp ---
ADMIN_PASSCODE=022005
ADMIN_SESSION_SECRET=replace-with-a-long-random-string   # e.g. output of: openssl rand -hex 32

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
TELEGRAM_BOT_USERNAME=@YourBotUsername            # shown in the "you're verified" message
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string  # any random string you invent
ADMIN_TELEGRAM_ID=your-own-telegram-numeric-id     # lets you run /{username}wallet etc for others

# --- Deployed app URL (set after first Vercel deploy) ---
PUBLIC_BASE_URL=https://your-app.vercel.app

# --- Polygon distribution ---
POLYGON_RPC_URL=https://polygon-rpc.com            # or an Alchemy/Infura Polygon RPC URL
DISTRIBUTOR_PRIVATE_KEY=0xyourprivatekey           # wallet that holds the tokens you distribute - fund it lightly

# --- Fraud detection ---
FINGERPRINT_SALT=replace-with-a-random-string
